{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev",
      "displayName": "Development",
      "description": "Debug build with warnings treated as errors",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ACO_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Optimised build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "sanitize",
      "displayName": "Sanitizers",
      "description": "AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ACO_WARNINGS_AS_ERRORS": "ON",
        "ACO_SANITIZERS": "address;undefined"
      }
    },
    {
      "name": "coverage",
      "displayName": "Coverage",
      "description": "Instrumented build for measuring test coverage",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ACO_ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "fuzz",
      "displayName": "Fuzzing",
      "description": "libFuzzer harnesses with sanitizers (requires Clang)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "clang",
        "ACO_BUILD_FUZZERS": "ON",
        "ACO_BUILD_TESTS": "OFF",
        "ACO_BUILD_EXAMPLES": "OFF",
        "ACO_SANITIZERS": "address;undefined"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev", "configuration": "Debug" },
    { "name": "release", "configurePreset": "release", "configuration": "Release" },
    { "name": "sanitize", "configurePreset": "sanitize", "configuration": "RelWithDebInfo" },
    { "name": "coverage", "configurePreset": "coverage", "configuration": "Debug" },
    { "name": "fuzz", "configurePreset": "fuzz", "configuration": "RelWithDebInfo" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "dev", "inherits": "base", "configurePreset": "dev", "configuration": "Debug" },
    {
      "name": "release",
      "inherits": "base",
      "configurePreset": "release",
      "configuration": "Release"
    },
    {
      "name": "sanitize",
      "inherits": "base",
      "configurePreset": "sanitize",
      "configuration": "RelWithDebInfo",
      "environment": {
        "ASAN_OPTIONS": "detect_stack_use_after_return=1:strict_string_checks=1",
        "UBSAN_OPTIONS": "print_stacktrace=1"
      }
    },
    {
      "name": "coverage",
      "inherits": "base",
      "configurePreset": "coverage",
      "configuration": "Debug"
    }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "displayName": "Configure, build and test (development)",
      "steps": [
        { "type": "configure", "name": "dev" },
        { "type": "build", "name": "dev" },
        { "type": "test", "name": "dev" }
      ]
    },
    {
      "name": "release",
      "displayName": "Configure, build and test (release)",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "release" },
        { "type": "test", "name": "release" }
      ]
    },
    {
      "name": "sanitize",
      "displayName": "Configure, build and test under sanitizers",
      "steps": [
        { "type": "configure", "name": "sanitize" },
        { "type": "build", "name": "sanitize" },
        { "type": "test", "name": "sanitize" }
      ]
    }
  ]
}
