/**
 * @file version.h
 * @brief Library version, generated by CMake from the project version.
 */
#ifndef ACO_VERSION_H
#define ACO_VERSION_H

#ifdef __cplusplus
extern "C" {
#endif

#define ACO_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define ACO_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define ACO_VERSION_PATCH @PROJECT_VERSION_PATCH@
/** Version as a string literal, for example "2.0.0". */
#define ACO_VERSION_STRING "@PROJECT_VERSION@"

/** Version of the library actually linked, which may differ from the headers. */
const char *aco_version(void);

#ifdef __cplusplus
}
#endif

#endif /* ACO_VERSION_H */
