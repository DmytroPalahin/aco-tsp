# Doxygen configuration for the API reference.
# Configured by CMake; build it with `cmake --build <dir> --target docs`.

PROJECT_NAME           = "aco-tsp"
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "@PROJECT_DESCRIPTION@"
OUTPUT_DIRECTORY       = "@PROJECT_BINARY_DIR@/docs"

# The public API is exactly what include/aco declares.
INPUT                  = "@PROJECT_SOURCE_DIR@/include/aco" \
                         "@ACO_GENERATED_INCLUDE_DIR@/aco/version.h"
FILE_PATTERNS          = *.h
RECURSIVE              = NO
STRIP_FROM_PATH        = "@PROJECT_SOURCE_DIR@/include" \
                         "@ACO_GENERATED_INCLUDE_DIR@"
STRIP_FROM_INC_PATH    = "@PROJECT_SOURCE_DIR@/include" \
                         "@ACO_GENERATED_INCLUDE_DIR@"

OPTIMIZE_OUTPUT_FOR_C  = YES
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
EXTRACT_ALL            = YES
EXTRACT_STATIC         = NO
SORT_MEMBER_DOCS       = NO
TYPEDEF_HIDES_STRUCT   = YES

# `extern "C"` guards are noise in a C reference.
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
PREDEFINED             = __cplusplus=0

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
HAVE_DOT               = NO

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO
